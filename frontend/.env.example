# Copy to frontend/.env.local for local development.
# Base path for API calls. "/api" uses the Vite dev proxy to localhost:8000.
VITE_API_BASE_URL=/api
# Where the Leave control and double-Esc send people. Site settings can override it.
VITE_QUICK_EXIT_URL=https://www.weather.gov/
# Where the dev server forwards /api and /media (read by vite.config.ts, not the browser).
# VITE_PROXY_TARGET=http://localhost:8000
