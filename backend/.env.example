# Copy to backend/.env for local development. Deployed settings are in render.yaml
# and docs/ops/deploy.md.
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Deployed environments refuse to start with the default "admin/".
DJANGO_ADMIN_PATH=admin/

# Matches docker-compose.yml (Postgres on host port 5433).
DATABASE_URL=postgres://rose:rose@localhost:5433/rose
# Redis is required when deployed (rate limits, the task queue). Locally it is optional.
CACHE_URL=redis://localhost:6380/1
CELERY_BROKER_URL=redis://localhost:6380/0
# Set to true to run Celery tasks inline instead of through a worker.
CELERY_TASK_ALWAYS_EAGER=false

# Public address of the site, used for links in emails.
SITE_URL=http://localhost:5173
# Days after an event ends before its RSVPs are deleted (counts are kept).
RSVP_RETENTION_DAYS=30
# Days a handled contact message is kept.
CONTACT_RETENTION_DAYS=365

# Storage: "local" keeps files in backend/media and backend/private_media. Set
# STORAGE_BACKEND=s3 and the S3_* settings (docs/ops/storage.md) to use buckets; the
# local MinIO from docker-compose.yml works with S3_ENDPOINT_URL=http://localhost:9000,
# S3_ADDRESSING_STYLE=path and the rose-public / rose-private buckets.
STORAGE_BACKEND=local

# Member feed. FEED_ENABLED=false is the incident kill switch (docs/ops/incident.md).
FEED_ENABLED=true
FEED_WATERMARK=true
# The watermark's strength (0 to 1) and the gap between marks as a share of the image width.
FEED_WATERMARK_OPACITY=0.06
FEED_WATERMARK_SPACING=0.34
FEED_PREMODERATION_POSTS=3
FEED_MAX_POSTS_PER_DAY=10
FEED_MAX_COMMENTS_PER_HOUR=60

# Membership and payments (see docs/payments.md). PAYMENT_PROVIDERS (comma-separated) is
# unset here, so it defaults to "manual,sandbox" with DEBUG on and "manual" with DEBUG off.
# The sandbox provider refuses to start with DEBUG off.
# Neutral name shown on receipts and used as the billing descriptor.
MERCHANT_DISPLAY_NAME=Rose
MEMBERSHIP_GRACE_DAYS=7
MEMBERSHIP_PENDING_EXPIRY_DAYS=30

# Email (docs/ops/email.md). "console" prints mail; "smtp" with the URL below sends it to
# the local Mailpit (http://localhost:8025). Deployed: postmark, amazon_ses, resend or mailgun.
EMAIL_PROVIDER=smtp
EMAIL_URL=smtp://localhost:1025
EMAIL_SENDER_NAME=Rose
EMAIL_SENDER_ADDRESS=no-reply@localhost
# Private inbox for contact notifications. Blank falls back to the public contact email.
CONTACT_NOTIFY_EMAIL=

# Security (docs/ops/security.md).
MEMBER_SESSION_DAYS=14
STAFF_SESSION_HOURS=12
# Outbound check against breached passwords; off by default (see the trade-off).
PASSWORD_BREACH_CHECK=false
CONTACT_RATE_LIMIT=5/h
LOGIN_RATE_LIMIT_IP=20/h
LOGIN_RATE_LIMIT_EMAIL=10/h
REGISTER_RATE_LIMIT_IP=5/h
REGISTER_RATE_LIMIT_EMAIL=3/h
PASSWORD_RESET_RATE_LIMIT_IP=5/h
PASSWORD_RESET_RATE_LIMIT_EMAIL=3/h
# Number of reverse proxies in front of the app (1 on Render, 0 locally).
DJANGO_TRUSTED_PROXY_COUNT=0

# Retention (docs/architecture.md, Data retention).
RENTAL_RETENTION_DAYS=90
VOLUNTEER_RETENTION_DAYS=365
NEWSLETTER_SUPPRESS_AFTER_DAYS=30

# Drafted site copy for load_site_content, and the staff guide shown in the admin.
# SITE_CONTENT_DIR=../content
# STAFF_GUIDE_PATH=../docs/staff-guide.md

# Nightly encrypted backups (docs/ops/restore.md). Off locally.
BACKUP_ENABLED=false
